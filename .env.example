# Monetag Ad Integration Configuration (17-Phase Architecture)
# Safe for Google AdSense and Core Web Vitals (CLS < 0.1, FID < 100ms)
NEXT_PUBLIC_MONETAG_PUSH_SCRIPT=
NEXT_PUBLIC_MONETAG_VIGNETTE_SCRIPT=
NEXT_PUBLIC_MONETAG_BANNER_ZONE=8888888

# Email Service (Resend or SMTP)
RESEND_API_KEY=
VIP_NOTIFICATION_EMAIL=admin@thesmartmag.com

# VIP Secret Key for PBKDF2/Sessions
VIP_JWT_SECRET=thesmartmag-autonomous-vip-key-2026

# ============================================================
# 💰 Affiliate Network IDs — Apple Hub & product buy links
# Every outbound buy button is tagged through these accounts.
# ============================================================
# Amazon Associates tag (default autoaiblog-21)
AMAZON_ASSOCIATE_TAG=autoaiblog-21
# Flipkart affiliate id (appended as affid=)
FLIPKART_AFFILIATE_ID=
# Cuelinks campaign id — wraps Croma / Reliance Digital / Vijay Sales /
# Flipkart links in the Cuelinks redirect gateway so those stores pay too.
CUELINKS_CAMPAIGN_ID=
# (Recommended: use the NEXT_PUBLIC_ variants so tags survive client bundles)
NEXT_PUBLIC_AMAZON_TAG=autoaiblog-21
NEXT_PUBLIC_FLIPKART_AFFILIATE_ID=
NEXT_PUBLIC_CUELINKS_CAMPAIGN_ID=
