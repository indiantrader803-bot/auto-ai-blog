# Database URL (SQLite default for frictionless local run, can be PostgreSQL for production)
DATABASE_URL="file:./dev.db"

# AI Provider API Keys
GEMINI_API_KEY=""
OPENAI_API_KEY=""
AI_MODEL_PREFERENCE="gemini-1.5-flash" # Options: gemini-1.5-flash, gemini-1.5-pro, gemini-2.0-flash, gpt-4o-mini

# Media API Keys (Optional, fallback provided)
UNSPLASH_ACCESS_KEY=""
PEXELS_API_KEY=""
YOUTUBE_API_KEY=""

# Monetization Settings
NEXT_PUBLIC_ADSENSE_CLIENT_ID="" # e.g. ca-pub-1234567890123456
NEXT_PUBLIC_BUY_ME_A_COFFEE_USERNAME="" # e.g. techpulse
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="AutoAI Chronicle"
NEXT_PUBLIC_SITE_DESCRIPTION="Automated AI-curated technology, science, finance, and culture deep-dives."

# Automation & Security
CRON_SECRET="auto-blog-secure-key-2025"
AUTO_PUBLISH_DEFAULT="true" # true = published immediately, false = saved as draft
DEFAULT_NICHE="Artificial Intelligence & Tech Breakthroughs"
POST_LANGUAGE="English"
TARGET_WORD_COUNT="1600"
